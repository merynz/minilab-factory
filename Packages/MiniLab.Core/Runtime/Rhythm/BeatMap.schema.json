{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MiniLab BeatMap",
  "type": "object",
  "required": ["trackId", "bpm", "offsetSec", "seed"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "trackId": { "type": "string" },
    "bpm": { "type": "number", "minimum": 1 },
    "offsetSec": { "type": "number" },
    "seed": { "type": "integer" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "startSec", "endSec"],
        "properties": {
          "type": { "type": "string", "enum": ["Rest", "Active"] },
          "startSec": { "type": "number" },
          "endSec": { "type": "number" },
          "density": { "type": "number", "minimum": 0, "maximum": 1 },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "restSections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startSec", "endSec"],
        "properties": {
          "startSec": { "type": "number" },
          "endSec": { "type": "number" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timeSec", "lane", "kind"],
        "properties": {
          "timeSec": { "type": "number" },
          "endTimeSec": { "type": "number" },
          "lane": { "type": "integer" },
          "kind": { "type": "string", "enum": ["Tap", "Accent", "Long", "RestSection", "Hold", "Gap"] },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "prefabId": { "type": "string" },
          "motion": { "type": "string" },
          "durationSec": { "type": "number", "minimum": 0 },
          "laneTo": { "type": "integer" }
        }
      }
    },
    "tapEvents": { "type": "array" },
    "holdEvents": { "type": "array" },
    "longEvents": { "type": "array" },
    "visualPulses": { "type": "array" },
    "breathGaps": { "type": "array" }
  }
}
